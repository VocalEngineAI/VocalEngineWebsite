# Copy to .env (already gitignored) to run `npm run generate:voice-demos`.
# Get a key from https://console.deepgram.com/ — the free trial credit covers
# generating these few short clips many times over.
DEEPGRAM_API_KEY=

# Optional: override the default Aura-2 voice model. See
# https://developers.deepgram.com/docs/tts-models for the full voice list.
# DEEPGRAM_VOICE_MODEL=aura-2-thalia-en
