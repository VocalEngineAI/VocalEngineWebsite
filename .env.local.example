# Copy to .env.local (already gitignored) to run `npm run generate:voice-demos`.
# Get a key from https://console.deepgram.com/ — the free trial credit covers
# generating these few short clips many times over.
DEEPGRAM_API_KEY=

# Optional: override the default Aura voice model (see Deepgram's docs for
# the full list of aura-*-en model names).
# DEEPGRAM_VOICE_MODEL=aura-asteria-en
